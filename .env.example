# ============================================================
# LOKAL RIVOJLANTIRISH (kompyuteringizda)
# ============================================================
DJANGO_DEPLOYMENT=local
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8000,https://localhost:8000
SECURE_SSL_REDIRECT=False

# Lokal PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kwork
DB_USER=kwork_user
DB_PASSWORD=strong_password
DB_HOST=localhost
DB_PORT=5432

# Email — Gmail App Password kerak (oddiy parol ishlamaydi)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Celery (ixtiyoriy, Redis kerak)
CELERY_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=kwork-cache

# HTTPS lokal: python manage.py runhttps
# Dev kutubxonalar: pip install -r requirements-dev.txt

