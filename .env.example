# Django
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Lokal HTTPS uchun (DEBUG=True bo'lganda):
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8000,https://localhost:8000
# SECURE_SSL_REDIRECT=False
# Ishga tushirish: python manage.py runhttps

# Database (production uchun PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kwork
DB_USER=kwork_user
DB_PASSWORD=strong_password
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Freelance.uz <your-email@gmail.com>

# Celery (deadline tekshiruvi uchun)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache (production)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# SSL (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
